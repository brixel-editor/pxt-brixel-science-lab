{
  "name": "brixel-science-lab",
  "version": "0.7.3",
  "description": "micro:bit V2 science sensor blocks and Bowerbird USB data collection (Bluetooth: brixel-science-lab-ble)",
  "license": "MIT",
  "dependencies": {
    "core": "*"
  },
  "files": [
    "core.ts",
    "sensors.ts",
    "communication.ts",
    "README.md",
    "_locales/ko/brixel-science-lab-strings.json",
    "_locales/en/brixel-science-lab-strings.json",
    "bus.ts",
    "native.cpp",
    "climate.ts",
    "motion-i2c.ts",
    "analog-science.ts",
    "calibration.ts",
    "digital-sensors.ts",
    "water-driver.ts",
    "lcd-driver.ts",
    "oled-driver.ts",
    "displays.ts",
    "air.ts",
    "ccs811.ts",
    "pulse.ts",
    "particulate.ts",
    "encoder.ts",
    "clock.ts",
    "uart.ts",
    "co2.ts",
    "distance.ts",
    "gesture.ts",
    "analog-measurements.ts",
    "gps.ts",
    "fingerprint.ts",
    "analog-dust.ts",
    "SOURCES.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "testFiles": [
    "test.ts"
  ],
  "public": true,
  "supportedTargets": [
    "microbit"
  ],
  "preferredEditor": "blocksprj",
  "disablesVariants": [
    "mbdal"
  ],
  "yotta": {
    "configIsJustDefaults": true,
    "config": {
      "HARDWARE_NEOPIXEL": 1
    }
  }
